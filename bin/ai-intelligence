#!/usr/bin/env python3
"""Source-backed design and engineering advice with explicit trust boundaries.

Personal projects use approved personal scope. Employer advisory mode uses only
public reference links and general personal guidance explicitly labeled as
external suggestions, never employer policy or automatic rule inheritance.
No project files or policy rules are written.
"""
import argparse
import json
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlsplit

ROOT = Path(__file__).resolve().parents[1]
SOURCES = ROOT / "knowledge" / "sources" / "catalog.json"
PATTERNS = ROOT / "knowledge" / "patterns" / "catalog.json"
EVIDENCE = ROOT / "knowledge" / "rule-evidence.json"
PERSONAL_PACK = ROOT / "policies" / "personal" / "policy.json"
PERSONAL_POLICY_LINK = "https://github.com/Enyina/ai-engineering-config/blob/main/policies/personal/policy.json"
ADVISORY_RULES = {
    "design": ("research.options", "design.clarity", "design.accessibility", "design.consistency", "design.evaluation"),
    "engineering": ("research.options", "engineering.source-evidence", "engineering.boundaries", "engineering.verification"),
}
VALID_DOMAINS = {"design", "engineering"}
SLUG = re.compile(r"^[a-z][a-z0-9-]{1,63}$")

class InputError(Exception):
    pass

def need(ok, why):
    if not ok:
        raise InputError(why)

def data(path):
    need(path.is_file() and not path.is_symlink() and path.stat().st_size < 300000,
         "Missing or unsafe knowledge catalog")
    return json.loads(path.read_text(encoding="utf-8"))

def validate():
    catalog, library = data(SOURCES), data(PATTERNS)
    need(catalog.get("schema_version") == 1 and catalog.get("owner") == "personal",
         "Knowledge sources must be personal")
    need(library.get("schema_version") == 1 and library.get("trust_domain") == "personal",
         "Knowledge patterns must be personal")
    sources = {}
    for source in catalog["sources"]:
        need(isinstance(source, dict) and SLUG.fullmatch(source.get("id", "")),
             "Invalid source ID")
        need(source["id"] not in sources, "Duplicate source ID")
        url = urlsplit(source.get("url", ""))
        need(url.scheme == "https" and bool(url.hostname) and not url.username
             and not url.password and not url.fragment and not url.port,
             "External sources must use public HTTPS references")
        need(source.get("source_scope") == "public" and
             source.get("rule_status") == "not-auto-approved",
             "Sources may not silently become rules")
        need(source.get("domain") in VALID_DOMAINS, "Invalid source domain")
        need(isinstance(source.get("insight"), str) and len(source["insight"]) > 15,
             "Source interpretation missing")
        sources[source["id"]] = source
    ids = set()
    for pattern in library["patterns"]:
        need(isinstance(pattern, dict) and SLUG.fullmatch(pattern.get("id", "")),
             "Invalid pattern ID")
        need(pattern["id"] not in ids and pattern.get("domain") in VALID_DOMAINS,
             "Duplicate pattern or unknown domain")
        ids.add(pattern["id"])
        need(isinstance(pattern.get("tags"), list) and
             len(pattern["tags"]) == len(set(pattern["tags"])) and
             all(isinstance(t, str) and t for t in pattern["tags"]),
             "Invalid pattern tags")
        need(isinstance(pattern.get("projects"), list) and
             all(SLUG.fullmatch(p) for p in pattern["projects"]), "Invalid project scope")
        need(len(pattern.get("sources", [])) >= 2 and
             all(k in sources and sources[k]["domain"] == pattern["domain"]
                 for k in pattern["sources"]), "Missing/foreign reference")
        options = pattern.get("options", [])
        need(isinstance(options, list) and 2 <= len(options) <= 5,
             "Need two to five real alternatives")
        opts = set()
        for option in options:
            need(isinstance(option, dict) and SLUG.fullmatch(option.get("id", "")),
                 "Bad alternative ID")
            need(option["id"] not in opts, "Repeated alternative")
            opts.add(option["id"])
            for field in ("label", "benefit", "tradeoff", "when", "verify"):
                need(isinstance(option.get(field), str) and option[field].strip(),
                     "Incomplete alternative: " + field)
    return sources, library["patterns"]

def preflight(workspace, project, feature, policy_root=None, intended_domain="personal"):
    command = [sys.executable, str(ROOT / "bin" / "ai-rules"), "resolve",
               "--workspace", str(workspace), "--project", project]
    if feature:
        command += ["--feature", feature]
    if policy_root is not None:
        command += ["--policy-root", str(policy_root)]
    check = subprocess.run(command, capture_output=True, text=True, timeout=15)
    need(check.returncode == 0, "Workspace, Git origin or policy domain not authorized")
    resolved = json.loads(check.stdout)
    need(resolved["trust_domain"] == intended_domain, "Policy trust domain does not match requested mode")
    if intended_domain == "personal":
        need(resolved["owner"] == "personal", "Personal policy owner mismatch")
    else:
        need(resolved["owner"] != "personal", "Employer advisory requires an employer-owned policy pack")
    return resolved

def employer_advisory_rules(domain, sources):
    """Expose only a vetted subset of general guidance with explicit provenance."""
    pack = data(PERSONAL_PACK)
    links = data(EVIDENCE)["rule_sources"]
    known = {item["id"]:item for item in pack["rules"]}
    guidance = []
    for rid in ADVISORY_RULES[domain]:
        need(rid in pack["global"]["rules"] or
             any(rid in cat.get("rules", []) for cat in pack["categories"].values()),
             "Proposed general guidance is not registered in personal rules")
        need(rid in links and rid in known, "Missing candidate rule provenance")
        refs = links[rid]["sources"]
        need(isinstance(refs, list) and refs and
             all(k in sources and sources[k]["source_scope"] == "public" for k in refs),
             "Candidate rule lacks public references")
        guidance.append({
            "id": rid, "guidance": known[rid]["text"],
            "source": {"type":"personal_generic_rule", "repository":"Enyina/ai-engineering-config",
                       "rule_id":rid, "url":PERSONAL_POLICY_LINK},
            "references":[{"publisher":sources[k]["publisher"],"url":sources[k]["url"]}
                          for k in refs],
            "status":"candidate_only_not_employer_policy",
            "authority":"Employer and platform instructions take precedence. Review compatibility before use."
        })
    return guidance

def suggest(sources, patterns, context, domain, task, tags, limit):
    requested = set(x.lower() for x in tags)
    requested |= set(re.findall(r"[a-z0-9]+", task.lower()))
    results = []
    for pattern in patterns:
        if pattern["domain"] != domain:
            continue
        if pattern["projects"] and context["project"] not in pattern["projects"]:
            continue
        matches = sorted(t for t in pattern["tags"] if
                         any(t == v or t in v or v in t for v in requested if len(v) >= 3))
        if not matches:
            continue
        # Domain and scope are hard filters; score only chooses relevance,
        # not the winning design approach.
        score = len(matches) * 10 + (4 if pattern["projects"] else 0)
        results.append((score, pattern["id"], pattern, matches))
    results.sort(key=lambda item: (-item[0], item[1]))
    chosen = []
    for score, _, p, matches in results[:limit]:
        chosen.append({
            "id": p["id"], "domain": domain, "category": p["category"],
            "problem": p["problem"], "matched_tags": matches,
            "evidence": [{"id": s, "publisher": sources[s]["publisher"],
                          "url": sources[s]["url"], "type": sources[s]["kind"]}
                         for s in p["sources"]],
            "alternatives": p["options"],
            "origin": {"type":"public_research_interpreted_in_personal_library",
                       "repository":"Enyina/ai-engineering-config",
                       "status":"reference_only_not_employer_policy"},
            "recommendation_status": "compare_then_validate",
            "selection": "none_preselected"
        })
    return {"trust_domain":context["trust_domain"],"project":context["project"],
            "feature":context.get("feature"),"domain":domain,"task":task,
            "matches":chosen,"unmatched":not bool(chosen),
            "advice": ("No relevant approved pattern. Propose a scoped research gap "
                       "instead of inventing a mandatory rule.") if not chosen else
                      "Compare alternatives against actual user and product evidence; "
                      "do not infer that a source endorses any one implementation.",
            "changes_applied":False}

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("validate", "suggest"))
    parser.add_argument("--workspace", type=Path)
    parser.add_argument("--policy-root", type=Path,
                        help="Explicit external employer-owned policy pack when verifying an employer workspace")
    parser.add_argument("--advisory-for-employer", action="store_true",
                        help="Suggest generic research and labeled personal guidance without applying company rules")
    parser.add_argument("--project")
    parser.add_argument("--feature")
    parser.add_argument("--domain", choices=sorted(VALID_DOMAINS))
    parser.add_argument("--task")
    parser.add_argument("--tags", default="", help="Comma-separated optional topic tags")
    parser.add_argument("--max", type=int, default=3, dest="limit")
    args = parser.parse_args()
    try:
        sources, patterns = validate()
        if args.command == "validate":
            output = {"valid": True, "trust_domain":"personal",
                      "sources": len(sources),"patterns":len(patterns)}
        else:
            need(bool(args.domain and args.task),
                 "A domain and short, non-confidential task description are required")
            need(1 <= args.limit <= 5 and len(args.task) <= 1000,
                 "Invalid limit or task length")
            if args.advisory_for_employer:
                # Lightweight advisory is useful before an employer has set up
                # a policy pack. It is never treated as approved employer policy.
                provided = [args.workspace is not None, bool(args.project),
                            args.policy_root is not None]
                need(all(provided) or not any(provided),
                     "For verified employer context supply workspace, project and external policy-root together")
                need(not args.feature or all(provided),
                     "A feature requires a verified employer workspace and policy pack")
                if all(provided):
                    need(args.policy_root.resolve() != (ROOT / "policies" / "personal").resolve(),
                         "Personal policy pack cannot stand in for employer policy")
                    verified = preflight(args.workspace, args.project, args.feature,
                                         args.policy_root, "employer")
                    context = {"trust_domain":"employer","project":None,"feature":None}
                    check_state = "employer_pack_workspace_and_origin_checked"
                else:
                    context = {"trust_domain":"employer","project":None,"feature":None}
                    check_state = "not_checked_no_employer_context_provided"
                output = suggest(sources, patterns, context, args.domain, args.task,
                                 [t.strip() for t in args.tags.split(",") if t.strip()], args.limit)
                output.pop("task", None)  # Do not print employer task text in reports.
                output["mode"] = "external_suggestions_only"
                output["employer_policy_check"] = check_state
                output["policy_conflicts_checked"] = False
                output["employer_rules_modified"] = False
                output["adoption"] = "Review employer policy, licensing and real project constraints; do not auto-import."
                output["candidate_personal_guidance"] = employer_advisory_rules(args.domain, sources)
            else:
                need(args.policy_root is None, "Use --advisory-for-employer for employer policy packs")
                need(bool(args.workspace and args.project),
                     "A personal workspace and project are required")
                context = preflight(args.workspace, args.project, args.feature)
                output = suggest(sources, patterns, context, args.domain, args.task,
                                 [t.strip() for t in args.tags.split(",") if t.strip()], args.limit)
        print(json.dumps(output, indent=2, ensure_ascii=False))
    except (InputError, ValueError, OSError, KeyError, subprocess.TimeoutExpired) as exc:
        # Intentionally omit raw task, paths, secrets or content.
        print("Intelligence request denied: " + str(exc), file=sys.stderr)
        return 2
    return 0

if __name__ == "__main__":
    sys.exit(main())
